# Configuración de AsistIA — TEINCO

# Base de datos (por defecto SQLite local sin dependencias, o descomentar PostgreSQL)
DATABASE_URL=sqlite:///./asistia.db
# DATABASE_URL=postgresql://postgres:teinco_secure_password_2026@localhost:5432/asistia_teinco

# Motor de Inteligencia Artificial (local_rag, gemini, o openai)
AI_PROVIDER=local_rag

# Google Gemini (100% Gratuito en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Seguridad JWT para el panel administrativo
JWT_SECRET_KEY=teinco_asistia_secret_key_2026_super_secure
